@inject NavigationManager navigationManager
@inject LengthProvider lengthProvider

<button class="large-text" aria-label="Length" @onclick="Click">@value</button>
@code {
    int value;
    protected override async Task OnInitializedAsync()
    {
        value = await lengthProvider.Get();
    }
    async Task Click()
    {
        value = await lengthProvider.Next(value);
        if (string.IsNullOrEmpty(navigationManager.ToBaseRelativePath(navigationManager.Uri)))
        {
            lengthProvider.NotifyChanged();
        }
        else
        {
            navigationManager.NavigateTo("");
        }
    }
}
