@page "/story/{Id:int?}"
@page "/story/{Anything}"
@using HnWasm.Navigation
@using HnWasm.TopStories
@inject NavigationService navigationService
@inject TopStoriesCache topStoriesCache;
@inject RestClient rest;
@inject ErrorState errorState
@if (story is not null)
{
    <PageTitle>@story.Title</PageTitle>
    <h2 class="large-text">
        <a class="title no-line" href=@(story?.Url ?? "story/"+@story?.Id)>@story?.Title</a>
    </h2>
    @if (story?.Url is not null)
    {
        <span class="small-text url">(@story.Url.UrlToHuman())</span>
    }
    <a class="small-text info hover-line" href="story/@story?.Id">
        @story?.Score points by @story?.By @story?.Time?.UnixToHuman() ago @story?.Descendants comments
    </a>
    @if (story?.Text is not null)
    {
        <span class="small-text markup">@((MarkupString)story.Text)</span>
    }
    @if (kids is not null)
    {
        @foreach (var comment in VisibleComments())
        {
            <Comment CommentItem=comment.Item
                     Indent=comment.Indent
                     IsExpanded=@(!collapsed.Contains(comment.Item.Id))
                     MoreCount=@GetKnownDescendantCount(comment.Item.Id)
                     OnToggle=ToggleComment
                     @key=comment.Item.Id />
        }
    }
}
@code {
    [Parameter] public string? Anything { get; set; }
    [Parameter] public int? Id { get; set; }
    Item? story;
    int[]? kids;
    int commentLoadVersion;
    List<CommentNode> comments = new();
    CommentNode[] commentSnapshot = Array.Empty<CommentNode>();
    HashSet<int> collapsed = new();
    HashSet<int> counting = new();
    Dictionary<int, int> descendantCounts = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            errorState.SetError(true,resetUrl:true);
            return;
        }
        var id = Id.Value;
        var version = ++commentLoadVersion;
        story = null;
        kids = null;
        comments.Clear();
        commentSnapshot = Array.Empty<CommentNode>();
        collapsed.Clear();
        counting.Clear();
        descendantCounts.Clear();
        navigationService.SetUrls(null, null);

        var storyTask = rest.GetItemFetch(id);
        var storiesTask = topStoriesCache.Get();

        var storyFetch = await storyTask;
        if (Id != id)
        {
            return;
        }
        if (storyFetch.Failed)
        {
            return;
        }
        story = storyFetch.Item;
        kids = story?.Kids;
        if (story is null)
        {
            errorState.SetError(true,resetUrl:true);
            return;
        }
        if (kids is not null)
        {
            rest.PrefetchItems(kids);
            _ = LoadComments(kids, 0, version, "");
        }
        StateHasChanged();

        var stories = await storiesTask;
        if (Id != id || stories is null)
        {
            return;
        }
        var index = Array.FindIndex(stories, item => item.Id == id);
        var previous = index <= 0 ? null : $"story/{stories[index - 1].Id}";
        var next = index == -1 || index == stories.Length - 1 ? null : $"story/{stories[index + 1].Id}";
        navigationService.SetUrls(previous, next);
        if (index > 0)
        {
            rest.PrefetchItems(new[] { stories[index - 1].Id });
        }
        if (index != -1 && index < stories.Length - 1)
        {
            rest.PrefetchItems(new[] { stories[index + 1].Id });
        }
    }

    async Task LoadComments(int[] ids, int indent, int version, string path)
    {
        rest.PrefetchItems(ids);
        var tasks = ids.Select(rest.GetItem).ToArray();
        for (var i = 0; i < tasks.Length; i++)
        {
            if (version != commentLoadVersion)
            {
                return;
            }
            var comment = await tasks[i];
            if (version != commentLoadVersion)
            {
                return;
            }
            if (comment?.Text is null)
            {
                continue;
            }
            var commentPath = $"{path}{i:D4}.";
            AddComment(new(comment, indent, commentPath));
            if (comment.Kids is not null)
            {
                collapsed.Add(comment.Id);
                rest.PrefetchItems(comment.Kids);
                if (indent == 0 && i < 5)
                {
                    StartCount(comment);
                }
                _ = LoadComments(comment.Kids, indent + 1, version, commentPath);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    IEnumerable<CommentNode> VisibleComments()
    {
        var hiddenIndent = int.MaxValue;
        foreach (var comment in OrderedComments())
        {
            if (comment.Indent > hiddenIndent)
            {
                continue;
            }
            hiddenIndent = int.MaxValue;
            yield return comment;
            if (collapsed.Contains(comment.Item.Id))
            {
                hiddenIndent = comment.Indent;
            }
        }
    }

    int? GetKnownDescendantCount(int id) => descendantCounts.TryGetValue(id, out var count) ? count : null;

    IEnumerable<CommentNode> OrderedComments() => commentSnapshot;

    void AddComment(CommentNode comment)
    {
        comments.Add(comment);
        commentSnapshot = comments.OrderBy(comment => comment.Path).ToArray();
    }

    async Task<int> CountDescendants(int id, int[] kids, int version)
    {
        if (descendantCounts.TryGetValue(id, out var knownCount))
        {
            return knownCount;
        }
        var count = 0;
        rest.PrefetchItems(kids);
        foreach (var kid in kids)
        {
            if (version != commentLoadVersion)
            {
                return count;
            }
            var item = await rest.GetItem(kid);
            if (version != commentLoadVersion)
            {
                return count;
            }
            if (item?.Text is null)
            {
                continue;
            }
            count++;
            if (item.Kids is not null)
            {
                count += await CountDescendants(item.Id, item.Kids, version);
            }
        }
        if (version == commentLoadVersion)
        {
            descendantCounts[id] = count;
            counting.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
        return count;
    }

    void ToggleComment(int id)
    {
        if (collapsed.Remove(id))
        {
            StartVisibleChildCounts(id);
            return;
        }
        collapsed.Add(id);
    }

    void StartVisibleChildCounts(int id)
    {
        var opened = comments.FirstOrDefault(comment => comment.Item.Id == id);
        if (opened is null)
        {
            return;
        }
        var ordered = commentSnapshot;
        var index = Array.IndexOf(ordered, opened);
        for (var i = index + 1; i < ordered.Length && ordered[i].Indent > opened.Indent; i++)
        {
            var child = ordered[i];
            if (child.Indent != opened.Indent + 1 || !collapsed.Contains(child.Item.Id))
            {
                continue;
            }
            StartCount(child.Item);
        }
    }

    void StartCount(Item item)
    {
        if (item.Kids is null || descendantCounts.ContainsKey(item.Id) || !counting.Add(item.Id))
        {
            return;
        }
        _ = CountDescendants(item.Id, item.Kids, commentLoadVersion);
    }

    record CommentNode(Item Item, int Indent, string Path);
}
