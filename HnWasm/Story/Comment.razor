@if (CommentItem.Text is not null)
{
    <div id="@CommentElementId" class="outer" style="margin-left: calc(@(Indent) * var(--indent-unit));">
        <div class="heading small-text">
            @CommentItem.By
            @CommentItem.Time?.UnixToHuman() ago
            @if (CommentItem.Kids is not null)
            {
                <a class="hover-line expand" @onclick="Toggle">
                    [@(IsExpanded ? "-" : MoreText)]
                </a>
            }
        </div>
        <span class="small-text markup">@((MarkupString)CommentItem.Text)</span>
    </div>
}
@code {
    [Parameter] public int Indent { get; set; }
    [Parameter] public Item CommentItem { get; set; } = null!;
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public int? MoreCount { get; set; }
    [Parameter] public EventCallback<int> OnToggle { get; set; }

    string MoreText => MoreCount is null ? "more" : $"{MoreCount} more";
    string CommentElementId => $"comment-{CommentItem.Id}";

    Task Toggle() => OnToggle.InvokeAsync(CommentItem.Id);
}
